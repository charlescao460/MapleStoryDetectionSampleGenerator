<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows7.0</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <PlatformTarget>x64</PlatformTarget>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\MapleStory.Sampler\MapleStory.Sampler.csproj" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <Content Include="..\WzComparerR2\References\x86\*.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Lib\x86\%(Filename)%(Extension)</TargetPath>
        </Content>
        <Content Include="..\WzComparerR2\References\x64\*.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Lib\x64\%(Filename)%(Extension)</TargetPath>
        </Content>
        <Content Include="..\WzComparerR2\References\ARM64\*.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>Lib\ARM64\%(Filename)%(Extension)</TargetPath>
        </Content>
    </ItemGroup>
    <Target Name="StageWzComparerMapRenderPlugin" AfterTargets="Build">
        <PropertyGroup>
            <_MapRenderPluginSourceDir>$(MSBuildThisFileDirectory)..\WzComparerR2\WzComparerR2\bin\$(Configuration)\$(TargetFramework)\Plugin\WzComparerR2.MapRender\</_MapRenderPluginSourceDir>
            <_MapRenderPluginTargetDir>$(TargetDir)Plugin\WzComparerR2.MapRender\</_MapRenderPluginTargetDir>
        </PropertyGroup>
        <RemoveDir Directories="$(_MapRenderPluginTargetDir)" Condition="Exists('$(_MapRenderPluginTargetDir)')" />
        <ItemGroup Condition="Exists('$(_MapRenderPluginSourceDir)')">
            <_MapRenderPluginFiles Include="$(_MapRenderPluginSourceDir)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_MapRenderPluginFiles)"
              DestinationFiles="@(_MapRenderPluginFiles->'$(_MapRenderPluginTargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"
              Condition="'@(_MapRenderPluginFiles)' != ''" />
    </Target>
</Project>
